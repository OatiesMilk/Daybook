NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact app origin; used for OAuth redirects. Use your Vercel URL in production.
SITE_URL=http://localhost:3000
# Public Cloudflare Turnstile site key. Store the matching secret only in Supabase Auth settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Keep false while registration uses Google. Enable only after SMTP and email confirmation are configured.
EMAIL_SIGNUP_ENABLED=false
# Optional: override the local Chrome/Chromium executable used for PDF export in dev.
# Leave unset to use the bundled browser from the `puppeteer` dev dependency.
CHROME_PATH=
