NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact app origin; used for OAuth redirects. Use your Vercel URL in production.
SITE_URL=http://localhost:3000
# Optional: override the local Chrome/Chromium executable used for PDF export in dev.
# Leave unset to use the bundled browser from the `puppeteer` dev dependency.
CHROME_PATH=
