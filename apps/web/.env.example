NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact app origin; used for OAuth redirects. Use your Vercel URL in production.
SITE_URL=http://localhost:3000
# Public Cloudflare Turnstile site key. Store the matching secret only in Supabase Auth settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Keep false while registration uses Google. Enable only after SMTP and email confirmation are configured.
EMAIL_SIGNUP_ENABLED=false
# Apply migration 010 for shared abuse limits before using Daybook Help.
DAYBOOK_HELP_ENABLED=true
# Optional server-only Gemini key for Help answers and Draft with AI (apply migrations 010 and 011).
# Missing key: Help uses FAQ answers and the Draft with AI panel is hidden.
# Set these in Vercel too. Never prefix the key with NEXT_PUBLIC_ or commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DAYBOOK_GEMINI_ENABLED=true
